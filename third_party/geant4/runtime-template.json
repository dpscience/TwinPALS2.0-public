  "event_time_kernel": {
    "format": "TPSTRM07",
    "record_bytes": 340,
    "channels": 2,
    "semantics": "Two detector summaries plus complete accepted-PE raw times, PMT onsets and cathode XY. Optical mean arrival remains relative to gamma emission; the separate analog response includes independent per-PE TTS and calibrated transit. PROV stores shared immutable branching transport ancestry referenced by each accepted photoelectron.",
    "includes_all_generated_events": true,
    "missing_mean": "zero payload with mean-valid flag unset",
    "primary_emission_offset_ns": 0,
    "outcome_semantics": "One primary event across both detector records: interaction, otherwise crystal entry, otherwise miss."
  },
  "parallelism": {
    "model": "Native G4MTRunManager with worker-local actions and shared immutable geometry/configuration",
    "per_event_seed_mode": 0,
    "event_modulo": 1,
    "rng": "CLHEP::MixMaxRng",
    "ordered_event_file": true,
    "compact_live_stdout": true,
    "pending_serialized_bytes_limit": 67108864,
    "pending_events_limit": "clamp(128*threads,256,8192)",
    "event_record_bytes_limit": 340,
    "memory_limit_scope": "64 MiB serialized reorder queue; each active Geant4 event also owns its accepted-PE list. Live batches are bounded by elapsed time, events and bytes.",
    "reproducibility": "Current regression includes native multithreaded transport, ordered writer lookahead, optical invariance under analysis cuts, and deterministic serial/parallel pulse processing. Exact cases and counts are in the linked report. No cross-version RNG promise."
  },
